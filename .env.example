# 必要な環境変数の一覧（値は書かない）。
# 値は、クラウド環境の設定（Environment variables / Network secrets）に入れる。
# このファイルに実際の値を書いてコミットしないこと。

# Jira / Confluence のサイト URL（末尾に / を付けない）
JIRA_BASE_URL=https://<サイト名>.atlassian.net

# Atlassian アカウントのメールアドレス
JIRA_EMAIL=<メールアドレス>

# API トークン（発行: https://id.atlassian.com/manage-profile/security/api-tokens）
JIRA_API_TOKEN=<発行したトークン>
